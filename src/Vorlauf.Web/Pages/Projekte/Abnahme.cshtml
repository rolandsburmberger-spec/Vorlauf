@page "{id:guid}"
@model Vorlauf.Web.Pages.Projekte.AbnahmeModel
@{
    ViewData["Title"] = "Abnahme";
    var ab = Model.Projekt.Abnahme;
}

<div class="vl-pagehead">
  <div>
    <div class="vl-crumb"><a asp-page="/Projekte/Index">Projekte</a> / <a asp-page="/Projekte/Detail" asp-route-id="@Model.Projekt.Id">@Model.Projekt.Bezeichnung</a> /</div>
    <h1>Abnahme</h1>
    <p class="text-muted small mb-0">Am Tablet ausfüllbar; Unterschrift direkt auf dem Bildschirm.</p>
  </div>
</div>

<div class="card" style="max-width: 40rem;" data-tour="abnahme-form"><div class="card-body">
  <form method="post" id="abnahmeForm">
    <div class="mb-3">
      <label class="form-label">Inbetriebnahmedatum</label>
      <input class="form-control" name="inbetriebnahme" type="date" value="@ab?.InbetriebnahmeDatum?.ToString("yyyy-MM-dd")" required />
    </div>
    <div class="mb-3">
      <label class="form-label">Abnahmeprotokoll</label>
      <textarea class="form-control" name="protokoll" rows="4" required>@ab?.ProtokollText</textarea>
    </div>
    <div class="mb-3">
      <label class="form-label">Unterschrift Kunde</label>
      <canvas id="unterschrift" width="500" height="150" style="touch-action:none; width:100%; max-width:500px;"></canvas>
      <div class="mt-1">
        <button class="btn btn-sm btn-outline-secondary" type="button" onclick="loescheUnterschrift()">Leeren</button>
      </div>
      <input type="hidden" name="unterschriftDataUrl" id="unterschriftDataUrl" value="@ab?.UnterschriftPngDataUrl" />
      @if (ab?.UnterschriftPngDataUrl is { } vorhanden)
      {
        <div class="mt-2"><img src="@vorhanden" alt="Vorhandene Unterschrift" style="max-height:80px; border:1px solid var(--vl-line); border-radius:6px;" /></div>
      }
    </div>
    <div class="form-check mb-3">
      <input class="form-check-input" type="checkbox" name="fachunternehmererklaerung" value="true" checked="@(ab?.FachunternehmererklaerungAusgestellt ?? false)" id="fue" />
      <label class="form-check-label" for="fue">
        <strong>Fachunternehmererklärung ausgestellt</strong> — ohne sie keine Schlussrechnung (KfW zahlt nicht aus)
      </label>
    </div>
    <button class="btn btn-primary" type="submit">Speichern</button>
    <a class="btn btn-outline-secondary" asp-page="/Projekte/Detail" asp-route-id="@Model.Projekt.Id">Zurück</a>
  </form>
</div></div>

@section Scripts {
<script>
  const canvas = document.getElementById('unterschrift');
  const ctx = canvas.getContext('2d');
  ctx.lineWidth = 2;
  ctx.lineCap = 'round';
  let zeichnet = false;
  let leer = true;

  function pos(e) {
    const r = canvas.getBoundingClientRect();
    const scaleX = canvas.width / r.width;
    const scaleY = canvas.height / r.height;
    return { x: (e.clientX - r.left) * scaleX, y: (e.clientY - r.top) * scaleY };
  }
  canvas.addEventListener('pointerdown', e => {
    zeichnet = true; leer = false;
    const p = pos(e);
    ctx.beginPath();
    ctx.moveTo(p.x, p.y);
    e.preventDefault();
  });
  canvas.addEventListener('pointermove', e => {
    if (!zeichnet) return;
    const p = pos(e);
    ctx.lineTo(p.x, p.y);
    ctx.stroke();
    e.preventDefault();
  });
  ['pointerup', 'pointerleave'].forEach(ev => canvas.addEventListener(ev, () => { zeichnet = false; }));

  function loescheUnterschrift() {
    ctx.clearRect(0, 0, canvas.width, canvas.height);
    leer = true;
  }

  document.getElementById('abnahmeForm').addEventListener('submit', () => {
    if (!leer) {
      document.getElementById('unterschriftDataUrl').value = canvas.toDataURL('image/png');
    }
  });
</script>
}
