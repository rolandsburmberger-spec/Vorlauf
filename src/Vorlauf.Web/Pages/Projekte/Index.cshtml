@page
@model Vorlauf.Web.Pages.Projekte.ProjektlisteModel
@{
    ViewData["Title"] = "Projekte";
}

<div class="vl-pagehead">
  <div>
    <h1>Projekte</h1>
    <p class="text-muted small mb-0">Alle Wärmepumpen-Projekte — filterbar nach Status auf der Prozessstrecke.</p>
  </div>
  <a class="btn btn-primary" asp-page="/Projekte/Neu">+ Neues Projekt</a>
</div>

<form method="get" class="mb-3">
  <select class="form-select w-auto d-inline-block" name="status" onchange="this.form.submit()" aria-label="Nach Status filtern">
    <option value="">Alle Status</option>
    @foreach (var s in Model.AlleStatus)
    {
      <option value="@s" selected="@(Model.Status == s)">@StatusAnzeige.Label(s)</option>
    }
  </select>
</form>

<div class="card" data-tour="projektliste">
  <div class="card-body">
    @if (Model.Projekte.Count == 0)
    {
      <p class="vl-empty mb-0">Keine Projekte in diesem Status.</p>
    }
    else
    {
      <table class="table table-hover mb-0">
        <thead><tr><th>Projekt</th><th>Kunde</th><th>Status</th><th class="text-end">Zuschuss (letzte Berechnung)</th></tr></thead>
        <tbody>
        @foreach (var (p, i) in Model.Projekte.Select((p, i) => (p, i)))
        {
          <tr>
            <td><a asp-page="/Projekte/Detail" asp-route-id="@p.Id" data-tour-first-project="@(i == 0 ? "1" : null)">@p.Bezeichnung</a></td>
            <td>@p.Kunde?.Name</td>
            <td><span class="vl-status @StatusAnzeige.Css(p.Status)">@StatusAnzeige.Label(p.Status)</span></td>
            <td class="text-end num">@(p.AktuelleFoerderberechnung is { } b ? b.Zuschuss.ToString("N0") + " €" : "—")</td>
          </tr>
        }
        </tbody>
      </table>
    }
  </div>
</div>
