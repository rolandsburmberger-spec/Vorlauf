@page
@model WPFlow.Web.Pages.LoginModel
@{
    ViewData["Title"] = "Anmelden";
}

<div class="row justify-content-center">
  <div class="col-md-4">
    <h1 class="h3 mb-3">WPFlow — Anmelden</h1>
    @if (Model.Fehler is not null)
    {
      <div class="alert alert-danger">@Model.Fehler</div>
    }
    <form method="post">
      <div class="mb-3">
        <label class="form-label" for="benutzer">Benutzer</label>
        <input class="form-control" id="benutzer" name="benutzer" autofocus />
      </div>
      <div class="mb-3">
        <label class="form-label" for="passwort">Passwort</label>
        <input class="form-control" id="passwort" name="passwort" type="password" />
      </div>
      <button class="btn btn-primary w-100" type="submit">Anmelden</button>
    </form>
    <p class="text-muted mt-3 small">Demo-Zugang: <code>demo / demo</code> (Mitarbeiter) oder <code>admin / admin</code>.</p>
  </div>
</div>
