@page
@model WPFlow.Web.Pages.Projekte.ProjektlisteModel
@{
    ViewData["Title"] = "Projekte";
}

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h3 mb-0">Projekte</h1>
  <a class="btn btn-primary" asp-page="/Projekte/Neu">Neues Projekt</a>
</div>

<form method="get" class="mb-3">
  <select class="form-select w-auto d-inline-block" name="status" onchange="this.form.submit()">
    <option value="">Alle Status</option>
    @foreach (var s in Model.AlleStatus)
    {
      <option value="@s" selected="@(Model.Status == s)">@s</option>
    }
  </select>
</form>

<table class="table table-hover">
  <thead><tr><th>Projekt</th><th>Kunde</th><th>Status</th><th>Zuschuss (letzte Berechnung)</th></tr></thead>
  <tbody>
  @foreach (var p in Model.Projekte)
  {
    <tr>
      <td><a asp-page="/Projekte/Detail" asp-route-id="@p.Id">@p.Bezeichnung</a></td>
      <td>@p.Kunde?.Name</td>
      <td><span class="badge text-bg-secondary">@p.Status</span></td>
      <td>@(p.AktuelleFoerderberechnung is { } b ? b.Zuschuss.ToString("N0") + " €" : "—")</td>
    </tr>
  }
  </tbody>
</table>
