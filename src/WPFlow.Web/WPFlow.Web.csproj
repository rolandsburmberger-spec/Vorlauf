<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    Bewusst ohne NuGet-Abhängigkeiten (nur Shared Framework): Auth läuft als
    Cookie-Auth mit Demo-Benutzern, Ablage in-memory (Domain-Port IProjektStore).
    Umstieg auf EF Core + ASP.NET Identity: ProjectReference auf
    WPFlow.Infrastructure ergänzen und in Program.cs den Store austauschen.
  -->
  <ItemGroup>
    <ProjectReference Include="..\WPFlow.Domain\WPFlow.Domain.csproj" />
  </ItemGroup>

</Project>
